# Django
SECRET_KEY=change-me-docker-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
CSRF_TRUSTED_ORIGINS=

# Koyeb / Gunicorn (PORT lo inyecta Koyeb según el puerto expuesto)
PORT=8000
WEB_CONCURRENCY=1
WEB_THREADS=2
WEB_TIMEOUT=120

# MySQL (Aiven o Docker Compose)
DB_ENGINE=django.db.backends.mysql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=22823
# Certificado CA de Aiven (ca.pem en la raíz del repo)
DB_SSL_CA=ca.pem
DB_SSL_MODE=VERIFY_CA
MYSQL_ROOT_PASSWORD=root

# Puertos publicados en el host
WEB_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# DRF / CORS
DRF_PAGE_SIZE=20
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Locale
LANGUAGE_CODE=es-co
TIME_ZONE=America/Bogota
LOG_LEVEL=INFO
INTEGRACIONES_LOG_LEVEL=INFO

# OneDrive sync (HU-SIG-001+)
# local = rutas en disco (ideal para probar frontend sin Graph)
